# LINE Official Account Manager URLs
# TODO: Set these after inspecting your LINE OA Manager instance
LINE_OA_MANAGER_URL=https://manager.line.biz/
LINE_OA_CHAT_URL=

# Database (Phase 2+)
DATABASE_SERVER=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_ENCRYPT=true

# Application
APP_PORT=3000
TIMEZONE=Asia/Bangkok
BUSINESS_START=08:00
BUSINESS_END=17:00
SLA_MINUTES=15
UNREAD_ALERT_MINUTES=30

# Collector
COLLECTOR_HEADLESS=false
COLLECTOR_TIMEOUT_MS=60000
STORAGE_STATE_PATH=auth/storage-state.json
# Set true to run Phase 2 scroll without writing to SQL Server
COLLECTOR_SKIP_DB=false

# Virtual scroll (Phase 2)
MAX_SCROLL_ATTEMPTS=500
NO_NEW_ITEM_LIMIT=3
SCROLL_WAIT_MS=800
# Keep scrolling until list .datetime shows เมื่อวาน (cover today's rooms)
SCROLL_UNTIL_YESTERDAY=true
SCROLL_YESTERDAY_MIN_HITS=1
SCROLL_LOAD_RETRY_MS=1500
SCROLL_LOAD_RETRY_MAX=8
# Scroll budget when hunting specific rooms (backfill) — ignores the เมื่อวาน stop,
# stops early as soon as every wanted room is loaded
LOOKUP_SCROLL_MAX_ATTEMPTS=80

# Phase 3 — conversation details (read rooms only)
DETAIL_MAX_ROOMS=20
DETAIL_HOVER_MS=300
DETAIL_OPEN_WAIT_MS=1500
DETAIL_MAX_TAGS=50
DETAIL_MAX_NOTES=300

# Phase 4 — message timeline
MESSAGE_LOOKBACK_DAYS=7
MESSAGE_MAX_PER_ROOM=300
MESSAGE_SCROLL_UP_ATTEMPTS=25
BACKFILL_MAX_ROOMS=25
# Name for outbound messages without .chat-header (logged-in agent self bubbles)
OUTBOUND_SELF_SENDER_NAME=

# Phase 5 — response KPI
SESSION_IDLE_MINUTES=30
KPI_MIN_TIME_CONFIDENCE=MEDIUM
KPI_EXCLUDE_UNKNOWN_EMPLOYEE_FROM_AGENT_TABLE=false

# PNG daily summary — exclude internal / self-chat rooms (name or tag substring)
REPORT_EXCLUDE_CUSTOMER_PATTERNS=ZUBB-TIK

# Inspector mode - logs DOM attributes for selector discovery
INSPECTOR_MODE=false
INSPECTOR_MAX_ROWS=5
